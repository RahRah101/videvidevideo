<!doctype html>
<!-- Generated by vvv from {{ script_name }}. Don't edit by hand: fix the script and rebuild. -->
<html lang="en">
<head>
<meta charset="UTF-8" />
<meta name="viewport" content="width={{ width }}, height={{ height }}" />
<style>
{%- for f in fonts %}
@font-face { font-family: "{{ f.family }}"; src: url("{{ f.src }}"); }
{%- endfor %}
* { margin: 0; padding: 0; box-sizing: border-box; }
html, body { width: {{ width }}px; height: {{ height }}px; overflow: hidden; background: #000; }
#root { position: relative; width: 100%; height: 100%; }
.clip { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: contain; }
.vvv-title { inset: auto; width: auto; height: auto; white-space: pre; }
</style>
</head>
<body>
<div id="root" data-composition-id="main" data-no-timeline data-start="0" data-duration="{{ duration }}" data-fps="{{ fps }}" data-width="{{ width }}" data-height="{{ height }}">
{%- for el in elements %}
{%- if el.tag == "audio" %}
  <audio id="{{ el.id }}" src="{{ el.src }}" data-start="{{ el.start }}" data-duration="{{ el.duration }}"{% if el.media_start %} data-media-start="{{ el.media_start }}"{% endif %} data-track-index="{{ el.track }}"></audio>
{%- elif el.tag == "video" %}
  <video id="{{ el.id }}" class="clip" src="{{ el.src }}" data-start="{{ el.start }}" data-duration="{{ el.duration }}"{% if el.media_start %} data-media-start="{{ el.media_start }}"{% endif %} data-track-index="{{ el.track }}"{% if el.has_audio %} data-has-audio="true"{% else %} muted{% endif %} style="z-index: {{ el.z }}"></video>
{%- elif el.tag == "img" %}
  <img id="{{ el.id }}" class="clip" src="{{ el.src }}" data-start="{{ el.start }}" data-duration="{{ el.duration }}" data-track-index="{{ el.track }}" style="z-index: {{ el.z }}">
{%- elif el.tag == "title" %}
  <div id="{{ el.id }}" class="clip vvv-title" data-start="{{ el.start }}" data-duration="{{ el.duration }}" data-track-index="{{ el.track }}" style="z-index: {{ el.z }}; {{ el.css }}">{{ el.text }}</div>
{%- endif %}
{%- endfor %}
</div>
</body>
</html>
